<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prueba de Login — FútbolStats Pro</title>
<style>
  * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
  body { margin: 0; background: #f5f6f8; color: #111; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }
  .card { background: #fff; border: 1.5px solid #e0e0e0; border-radius: 16px; padding: 32px 28px; max-width: 420px; width: 100%; box-shadow: 0 4px 20px rgba(0,0,0,.05); }
  .tag { display: inline-block; font-size: 11px; background: #fff3cd; color: #856404; padding: 3px 10px; border-radius: 10px; font-weight: 600; margin-bottom: 16px; }
  h1 { font-size: 20px; margin: 0 0 6px; }
  p.sub { font-size: 13px; color: #888; margin: 0 0 22px; line-height: 1.5; }
  label { font-size: 13px; font-weight: 600; display: block; margin-bottom: 6px; }
  input { width: 100%; padding: 12px 14px; font-size: 15px; border: 1.5px solid #ddd; border-radius: 10px; outline: none; }
  input:focus { border-color: #111; }
  button { width: 100%; margin-top: 14px; padding: 13px; font-size: 15px; font-weight: 600; background: #111; color: #fff; border: none; border-radius: 10px; cursor: pointer; }
  button:hover { background: #333; }
  button:disabled { background: #999; cursor: default; }
  .msg { margin-top: 16px; font-size: 13px; line-height: 1.5; padding: 12px 14px; border-radius: 10px; display: none; }
  .msg.info { display: block; background: #e8f4fd; color: #1565c0; }
  .msg.ok { display: block; background: #d4edda; color: #1a5e34; }
  .msg.err { display: block; background: #f8d7da; color: #842029; }
  .logged { text-align: center; }
  .logged .email { font-weight: 700; word-break: break-all; }
  .check { font-size: 44px; }
  .logout { background: #fff; color: #842029; border: 1.5px solid #f1aeb5; margin-top: 20px; }
  .logout:hover { background: #fdf2f3; }
</style>
</head>
<body>
  <div class="card">
    <span class="tag">🧪 PÁGINA DE PRUEBA</span>

    <!-- Estado 1: no ha iniciado sesión -->
    <div id="form-view">
      <h1>Ingresa a FútbolStats Pro</h1>
      <p class="sub">Escribe tu correo y te enviaremos un enlace mágico. Haz clic en él y entrarás sin contraseña.</p>
      <label for="email">Correo electrónico</label>
      <input id="email" type="email" placeholder="tucorreo@ejemplo.com" autocomplete="email">
      <button id="send-btn" onclick="enviarLink()">Enviar enlace mágico →</button>
      <div id="msg" class="msg"></div>
    </div>

    <!-- Estado 2: ya inició sesión -->
    <div id="logged-view" class="logged" style="display:none">
      <div class="check">✅</div>
      <h1>¡Estás dentro!</h1>
      <p class="sub">El login por enlace mágico funcionó correctamente. Iniciaste sesión como:</p>
      <p class="email" id="user-email"></p>
      <button class="logout" onclick="cerrarSesion()">Cerrar sesión</button>
    </div>
  </div>

  <!-- Librería oficial de Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    // Estos dos valores son públicos (ya viven en tu app.js). La clave 'anon'
    // está protegida por las reglas de seguridad de Supabase (RLS).
    const SUPABASE_URL = 'https://rhmrmrmvqwthhgihzvog.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJobXJtcm12cXd0aGhnaWh6dm9nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI1OTM4MjYsImV4cCI6MjA5ODE2OTgyNn0.5VkR9LsNQ4eG81Im5deV567qEN1iFLVTzAg3S3_6UXs';

    const sb = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

    const $ = (id) => document.getElementById(id);

    function mostrarMensaje(texto, tipo) {
      const m = $('msg');
      m.textContent = texto;
      m.className = 'msg ' + tipo;
    }

    // Enviar el enlace mágico
    async function enviarLink() {
      const email = $('email').value.trim();
      if (!email || !email.includes('@')) {
        mostrarMensaje('Por favor escribe un correo válido.', 'err');
        return;
      }
      const btn = $('send-btn');
      btn.disabled = true;
      btn.textContent = 'Enviando...';
      mostrarMensaje('Enviando el enlace...', 'info');

      const { error } = await sb.auth.signInWithOtp({
        email: email,
        options: { emailRedirectTo: window.location.origin + window.location.pathname }
      });

      if (error) {
        mostrarMensaje('Ups, algo falló: ' + error.message, 'err');
        btn.disabled = false;
        btn.textContent = 'Enviar enlace mágico →';
      } else {
        mostrarMensaje('📩 ¡Listo! Revisa tu correo (y la carpeta de spam). Haz clic en el enlace para entrar.', 'ok');
        btn.textContent = 'Enlace enviado ✓';
      }
    }

    // Cerrar sesión
    async function cerrarSesion() {
      await sb.auth.signOut();
      window.location.reload();
    }

    // Mostrar la vista correcta según si hay sesión activa
    async function revisarSesion() {
      const { data: { session } } = await sb.auth.getSession();
      if (session && session.user) {
        $('form-view').style.display = 'none';
        $('logged-view').style.display = 'block';
        $('user-email').textContent = session.user.email;
      } else {
        $('form-view').style.display = 'block';
        $('logged-view').style.display = 'none';
      }
    }

    // Al cargar la página (incluye cuando vuelve desde el enlace del correo)
    revisarSesion();
    sb.auth.onAuthStateChange(() => revisarSesion());
  </script>
</body>
</html>
